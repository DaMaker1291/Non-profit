[TEMPLATE]
# ── OpenMind environment ────────────────────────────────────────────────────
# Copy to .env and edit. Everything here is optional.

# Where learning data lives (profiles, rooms, classes, packs).
# Default: ./.openmind-data — point it anywhere writable (USB stick, mounted
# school drive, Docker volume). Copy the directory to back up the deployment.
#
# ON A HOST, THIS IS REQUIRED IN PRACTICE: the production build refuses to be
# ready without it, because a redeploy replaces the application directory and a
# classroom lives in there. Set it to the mounted volume — /data on Fly and
# Docker, a Render disk's mount path, a school drive. ./start-openmind.sh
# declares it for you on a laptop.
#
# AND WHERE THE HOST DISCARDS ITS FILESYSTEM (Render, Heroku, Fly, Cloud Run,
# Azure — recognised from each platform's own markers) THE DIRECTORY MUST BE A
# MOUNTED VOLUME, not merely declared: a path that is a directory in the layer
# the host throws away is reported as `data_dir_not_durable` (ready:false /
# HTTP 503), because a learner created there is lost when the instance sleeps.
# See docs/DEPLOYMENT.md §6.2 for the measurement.
# OPENMIND_DATA_DIR=

# A THROWAWAY instance only (a demo, a CI box, a preview): say in so many words
# that losing every learner on the next deploy is accepted. Without this, the
# production build with no OPENMIND_DATA_DIR reports ready:false / HTTP 503.
# OPENMIND_ALLOW_EPHEMERAL_STORE=

# Which storage backend to run. Default: the file store (flat JSON under
# OPENMIND_DATA_DIR) — zero setup, and the only backend this build implements.
# `postgres` is SPECIFIED (docs/STORAGE_SPEC.md) AND NOT BUILT yet: setting it is
# REFUSED at startup rather than silently serving files, because the file store is
# single-process and a deployment that believes it is on Postgres is how records
# end up in the wrong place. An unrecognised value is refused too.
# OPENMIND_STORE=file

# Optional: add any ONE of these to upgrade the Socratic tutor to LLM-backed.
# Without a key the offline rule-based tutor is used — no feature is gated, and
# every failure mode of a configured model (no key for a request, provider
# error, timeout, unparseable body) falls back to that same offline tutor with
# the learner told which of the two answered.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Optional: your OWN OpenAI-compatible endpoint (a self-hosted model, a school
# or regional gateway). Takes precedence over the vendor keys above, so a
# deployment running its own model is never shadowed by a stray key.
# OPENMIND_AI_BASE_URL=https://my-model.internal/v1/chat/completions
# OPENMIND_AI_KEY=
# OPENMIND_AI_MODEL=self-hosted
# How long a model call may take before the offline tutor answers instead (ms).
# Default 12000.
# OPENMIND_AI_TIMEOUT_MS=12000

# Optional: the operator key for /api/impact (the funder-facing aggregate view).
# OPENMIND_IMPACT_KEY=

# Optional: session-cookie signing secret. Generated and stored in the data
# directory when unset — set it explicitly when running more than one instance,
# and keep it beside a backup so a restore does not sign every learner out.
# OPENMIND_SESSION_SECRET=
