{
  "name": "openmind",
  "version": "1.0.0",
  "description": "OpenMind — a free, open-source, multilingual learning network. Adaptive learning with optional AI assistance: the diagnostic, the question bank, the grader, the learner model and the tutor are all deterministic and work with no model configured, so the AI is an extra rather than the product. `npm run verify` proves the engines, `npm run verify:q` proves every generated question is answerable, `npm run e2e` proves the API end to end. `npm run benchmark` measures what the decision engine actually decides for adversarial learner states — and, deliberately, does not measure learning.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4173",
    "build": "next build",
    "verify:build": "node scripts/verify-build-assets.mjs",
    "verify:render": "node scripts/verify-render.mjs",
    "start": "next start -p 4173",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-engines.mjs",
    "benchmark": "node scripts/educational-benchmark.mjs",
    "reliability": "node scripts/north-star.mjs",
    "content-check": "node scripts/content-check.mjs",
    "verify:q": "node scripts/verify-questions.mjs",
    "gate:ceiling": "node scripts/ceiling-gate.mjs",
    "content-audit": "node scripts/content-audit.mjs",
    "content-gate": "node scripts/content-gate.mjs",
    "e2e": "node scripts/e2e-api.mjs",
    "e2e:fresh": "node scripts/run-production-e2e.mjs",
    "e2e:fresh:only": "node scripts/e2e-fresh-learner.mjs",
    "verify:ui": "node scripts/ui-walk.mjs",
    "verify:live": "node scripts/static-page-walk.mjs",
    "verify:permissions": "node scripts/verify-permissions.mjs",
    "verify:sync": "node scripts/verify-offline-sync.mjs",
    "verify:content-release": "node scripts/verify-content-release.mjs",
    "db:migrate": "node scripts/migrate.mjs up",
    "db:status": "node scripts/migrate.mjs status",
    "db:down": "node scripts/migrate.mjs down",
    "db:verify": "node scripts/migrate.mjs verify",
    "db:rehearse": "node scripts/migrate.mjs rehearse",
    "smoke": "node scripts/smoke-production.mjs",
    "production-check": "node scripts/production-check.mjs",
    "build:static": "node scripts/build-static-app.mjs",
    "verify:static": "node scripts/static-smoke.mjs",
    "ai-stub": "node scripts/ai-stub.mjs",
    "superiority-test": "node scripts/superiority-test.mjs",
    "product-benchmark": "node scripts/run-product-benchmark.mjs",
    "product-benchmark:only": "node scripts/product-superiority-benchmark.mjs"
  },
  "dependencies": {
    "next": "^15.5.25",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.2"
  }
}
