node_modules
.next
out
*.log
.DS_Store
.env*.local
.env

# Build and verification artefacts — reproducible, never committed.
tsconfig.tsbuildinfo
.verify
.contentcheck
# Scratch renders of the UI (server HTML with the stylesheet inlined) so a page
# can be LOOKED at without running the app. Regenerated on demand, never
# committed: it is a screenshot in a different format.
.ui-preview
# The static build's compile mirror. docs/ IS committed (it is what Pages
# serves), but this intermediate output is not: `npm run build:static` rewrites
# both from the same sources.
.static-build
.next/
.next-prod/
.freebuff
# Every other build directory the verification suites emit. `.next/` and
# `.next-prod/` were listed and these were not, so `npm run verify`,
# `npm run e2e`, `npm run verify:ui` and `npm run production-check` each left a
# full Next.js build tree untracked in the working directory — several hundred
# megabytes of reproducible output sitting one `git add -A` away from the
# published site.
.next-check/
.next-dev/
.next-e2e/
.next-ui/

# Learning data — never commit a classroom.
.openmind-data
openmind-data

# The product benchmark's baseline record — regenerated on every run, never committed.
.benchmark
